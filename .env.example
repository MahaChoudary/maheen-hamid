# Copy to .env.local. Empty fields are placeholders; never commit .env.local.
# Next.js serves frontend and backend together on this origin.
SITE_URL=
ALLOWED_ORIGINS=
# Set true only after provider privacy/ZDR settings and quotas are verified.
AI_ENABLED=
AI_PRIVACY_VERIFIED=
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=
# Shared distributed quota storage. Required for all model calls.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=
AI_IP_SOURCE=
# Optional deployment cost budgets; defaults: 2000 requests / 2M tokens per day.
# Production session windows: Mira 30, Explainer 10, Matcher 10 per 10 minutes.
# Loopback next dev uses effectively unrestricted budgets. Set true to test production limits.
AI_ENFORCE_PRODUCTION_LIMITS=
AI_DAILY_REQUEST_LIMIT=
AI_DAILY_TOKEN_LIMIT=
# Optional OpenAI-compatible provider configuration (not automatic failover).
AI_PROVIDER_NAME=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TOKENIZER=
AI_TOKENIZER_VERIFIED=
AI_RESPONSE_FORMAT=
